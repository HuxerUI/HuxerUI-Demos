<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="Huxer-Graph" Manufacturer="com.huxerui.demos.huxergraph" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
          UpgradeCode="@HUXERUI_WINDOWS_BUNDLE_UPGRADE_CODE@"
          IconSourceFile="!(bindpath.Project)\app.ico">
    <BootstrapperApplication SourceFile="!(bindpath.Installer)\huxer_graph-Installer.exe">
      <PayloadGroupRef Id="HuxerUIInstallerPayloads" />
    </BootstrapperApplication>
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]Huxer-Graph" />
    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="0" />
    <Chain>
      <MsiPackage SourceFile="!(bindpath.Package)\huxer_graph.msi">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="CREATE_DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
